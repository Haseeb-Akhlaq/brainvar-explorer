# Production environment for the whole stack. Copy to .env.prod on the server.
#
# It lives at the repository root, next to the compose file that reads it,
# because it configures every service: Django, Postgres and the frontend
# build argument. (backend/.env is different — that one is only for running
# manage.py on the host during development, where settings.py loads it.)
# NEVER commit the real file — it is gitignored.
#
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# token_urlsafe avoids '$', which docker compose treats as a variable reference.

DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=brainvar.haseebakhlaq.com,api.brainvar.haseebakhlaq.com
LOG_LEVEL=INFO

# TLS terminates at nginx, which forwards X-Forwarded-Proto. Leave this False
# or Django will redirect a request nginx has already served over HTTPS.
SECURE_SSL_REDIRECT=False

# --- Split origins ---------------------------------------------------------
# The app and the API are on different subdomains, so the browser needs the
# API to send CORS headers, and cookies must be scoped to the shared parent.

CORS_ALLOWED_ORIGINS=https://brainvar.haseebakhlaq.com
CSRF_TRUSTED_ORIGINS=https://brainvar.haseebakhlaq.com,https://api.brainvar.haseebakhlaq.com

# Leading dot: one cookie valid on both brainvar.* and api.brainvar.*
SESSION_COOKIE_DOMAIN=.brainvar.haseebakhlaq.com
CSRF_COOKIE_DOMAIN=.brainvar.haseebakhlaq.com

# --- PostgreSQL (container, not RDS) ---------------------------------------
POSTGRES_DB=brainvar_explorer
POSTGRES_USER=brainvar
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Where the loader reads the raw files inside the container.
BRAINVAR_DATA_DIR=/data

# --- Frontend build --------------------------------------------------------
# Baked into the bundle at build time, so a change requires a rebuild.
VITE_API_URL=https://api.brainvar.haseebakhlaq.com

# --- Email (account invitations) -------------------------------------------
# Sent when an admin invites a user from the panel. With EMAIL_HOST_USER empty
# Django falls back to the console backend, so the stack still runs and prints
# invitations to the log instead of failing.
#
# Gmail needs an *app password*, not the account password, and only issues one
# once two-factor authentication is on:
#   https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-me@gmail.com
EMAIL_HOST_PASSWORD=replace-me
EMAIL_FROM_NAME=BrainVar Trajectory Explorer
EMAIL_FROM_ADDRESS=replace-me@gmail.com

# Where the invitation tells the recipient to sign in — the app, not the API.
APP_LOGIN_URL=https://brainvar.haseebakhlaq.com/login
