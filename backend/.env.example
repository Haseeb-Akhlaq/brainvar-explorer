# Copy to backend/.env and adjust. Never commit the real .env.
# This file is read by both Django (settings.py) and docker-compose.local.yml.

DJANGO_SECRET_KEY=change-me-generate-a-real-one
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
LOG_LEVEL=INFO

# Frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL — matches the db service in docker-compose.local.yml
POSTGRES_DB=brainvar_explorer
POSTGRES_USER=brainvar
POSTGRES_PASSWORD=brainvar
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
