# Development image: Vite dev server with hot reload. Source is volume-mounted
# by docker-compose.local.yml, so only dependencies are baked in.
# Node 22: Vite 8 requires Node ^20.19 or >=22.12.
FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
